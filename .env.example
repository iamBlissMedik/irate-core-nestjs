# Copy to `.env` and adjust. Every variable is validated at startup (src/config/env.ts);
# the API refuses to boot with an invalid value, or with development defaults in production.

# --- Runtime ------------------------------------------------------------------
NODE_ENV=development                 # development | test | production
PORT=8000
# LOG_LEVEL=debug                    # fatal|error|warn|info|debug|trace|silent (default: debug, info in production)

# --- Infrastructure -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irate_core_nest
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ---------------------------------------------------------------------
# REQUIRED in production (>= 32 chars). Generate: openssl rand -hex 32
# JWT_ACCESS_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# JWT_ISSUER=irate-core
# JWT_AUDIENCE=irate-api
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_REUSE_GRACE_SECONDS=20     # a rotated token reused within this window is a benign race, not theft
# COOKIE_SECURE=                     # default: true in production, false otherwise
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900

# --- HTTP ---------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:9000   # exact origins, never *
# TRUST_PROXY_HOPS=0                 # reverse proxies in front of the API; 1 behind the Next.js BFF
#                                    # (it forwards the browser's IP). Only expose the API to those proxies.
# SWAGGER_ENABLED=                   # default: true outside production (served at /docs)
# RATE_LIMIT_ENABLED=true            # cannot be false in production

# --- Money --------------------------------------------------------------------
# DEFAULT_CURRENCY=NGN
# SUPPORTED_CURRENCIES=NGN           # comma-separated; system wallets are created for each
# MAX_TRANSACTION_AMOUNT=1000000000  # minor units per transaction (NGN 10,000,000)
# UNVERIFIED_DAILY_TRANSFER_LIMIT=5000000   # minor units/day without VERIFIED KYC (NGN 50,000); 0 disables
# BUSINESS_TIMEZONE=Africa/Lagos     # defines "today" for limits and dashboard stats

# --- Payments -----------------------------------------------------------------
PAYMENTS_PROVIDER=sandbox            # sandbox | paystack
# PUBLIC_API_URL=http://localhost:8000
# SANDBOX_WEBHOOK_SECRET=            # REQUIRED in production when the sandbox is active (>= 32 chars)
# PAYSTACK_SECRET_KEY=sk_test_...    # required when PAYMENTS_PROVIDER=paystack
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_CALLBACK_URL=https://app.example.com/deposits/complete

# --- Seed (npm run db:seed, never in production) ------------------------------
# SEED_ADMIN_EMAIL=admin@irate.dev
# SEED_ADMIN_PASSWORD=Admin123!
# SEED_USER_PASSWORD=Password123!
