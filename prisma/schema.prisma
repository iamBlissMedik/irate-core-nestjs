// iRate — database schema.
//
// Conventions
// - Tables and columns are snake_case in Postgres (@@map / @map), camelCase in TypeScript.
// - Primary keys are UUIDv7 (time-ordered, so inserts stay index-friendly).
// - Money is ALWAYS an integer number of minor units (kobo) in a BIGINT column.
// - Timestamps are `timestamptz` and stored in UTC.
//
// Invariants that Prisma cannot express (CHECK constraints, the append-only
// ledger trigger and the balanced-journal trigger) live in the SQL migrations;
// see prisma/migrations/*_ledger_invariants/migration.sql.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Always trimmed + lower-cased by the application (and enforced by a CHECK).
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  kyc           KycRecord?
  reviewedKycs  KycRecord[]    @relation("KycReviewer")
  wallets       Wallet[]
  refreshTokens RefreshToken[]
  deposits      Deposit[]

  @@index([createdAt(sort: Desc)])
  @@map("users")
}

/// Refresh tokens are opaque random strings. Only the SHA-256 hash is stored.
/// Every refresh ROTATES the token (same family); re-using a rotated token
/// revokes the whole family (stolen-token detection).
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// KYC
// ---------------------------------------------------------------------------

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum KycIdType {
  NIN
  BVN
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
}

/// One KYC record per user. A rejected record is re-submitted in place.
/// Review is a compare-and-set on PENDING, so a decision is final.
model KycRecord {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  fullName        String    @map("full_name")
  dateOfBirth     DateTime  @map("date_of_birth") @db.Date
  address         String
  idType          KycIdType @map("id_type")
  idNumber        String    @map("id_number")
  documentUrl     String?   @map("document_url")
  status          KycStatus @default(PENDING)
  rejectionReason String?   @map("rejection_reason")
  reviewedById    String?   @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(3)
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(3)
  submittedAt     DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@map("kyc_records")
}

// ---------------------------------------------------------------------------
// Wallets & double-entry ledger
// ---------------------------------------------------------------------------

/// USER wallets belong to a customer and can never go negative.
/// SYSTEM wallets are the platform's own accounts (SETTLEMENT for money that
/// arrives from a payment provider, ADJUSTMENTS for admin credits). They are
/// the "other side" of every posting that moves money into or out of the
/// platform, so the sum of all balances per currency is always exactly zero.
enum WalletKind {
  USER
  SYSTEM
}

/// FROZEN means "post no debit": the wallet can still receive money but
/// nothing can leave it until an admin unfreezes it.
enum WalletStatus {
  ACTIVE
  FROZEN
}

model Wallet {
  id            String       @id @default(uuid(7)) @db.Uuid
  userId        String?      @map("user_id") @db.Uuid
  kind          WalletKind   @default(USER)
  systemCode    String?      @map("system_code")
  /// 10-digit NUBAN-style number that customers share to receive money.
  accountNumber String       @unique @map("account_number") @db.Char(10)
  currency      String       @default("NGN") @db.Char(3)
  /// Integer minor units (kobo).
  balance       BigInt       @default(0)
  status        WalletStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries             LedgerEntry[] @relation("EntryWallet")
  counterpartyEntries LedgerEntry[] @relation("EntryCounterparty")
  deposits            Deposit[]

  /// One wallet per customer per currency (NULL user_ids never collide).
  @@unique([userId, currency])
  /// One system account per code per currency.
  @@unique([systemCode, currency])
  @@map("wallets")
}

enum TransactionKind {
  TRANSFER
  DEPOSIT
  ADMIN_CREDIT
}

/// Postings are synchronous today, so every journal is COMPLETED. The other
/// states exist for asynchronous rails (payouts) on the roadmap.
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

/// A journal header: one business event ("Ada sent Bola 2,500").
model Transaction {
  id            String            @id @default(uuid(7)) @db.Uuid
  reference     String            @unique
  kind          TransactionKind
  status        TransactionStatus @default(COMPLETED)
  amount        BigInt
  currency      String            @db.Char(3)
  description   String
  note          String?
  initiatedById String?           @map("initiated_by") @db.Uuid
  metadata      Json              @default("{}")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]
  deposit Deposit?

  @@index([createdAt])
  @@index([kind, createdAt])
  @@map("transactions")
}

enum EntryDirection {
  DEBIT
  CREDIT
}

/// A journal line. The entries of one transaction always net to zero
/// (enforced at COMMIT by a deferred trigger) and are append-only.
model LedgerEntry {
  id                   String         @id @default(uuid(7)) @db.Uuid
  transactionId        String         @map("transaction_id") @db.Uuid
  walletId             String         @map("wallet_id") @db.Uuid
  direction            EntryDirection
  amount               BigInt
  balanceBefore        BigInt         @map("balance_before")
  balanceAfter         BigInt         @map("balance_after")
  description          String
  counterpartyWalletId String?        @map("counterparty_wallet_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction        Transaction @relation(fields: [transactionId], references: [id])
  wallet             Wallet      @relation("EntryWallet", fields: [walletId], references: [id])
  counterpartyWallet Wallet?     @relation("EntryCounterparty", fields: [counterpartyWalletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([transactionId])
  @@index([createdAt])
  @@map("ledger_entries")
}

// ---------------------------------------------------------------------------
// Idempotency & audit
// ---------------------------------------------------------------------------

/// Written in the SAME database transaction as the money movement it protects,
/// so "the transfer happened" and "the key is recorded" commit atomically.
/// Keys are scoped per user and per operation.
model IdempotencyKey {
  userId       String   @map("user_id") @db.Uuid
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}

/// Money-moving actions write their audit row inside the same transaction as
/// the movement: an audit record exists if and only if the action committed.
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  actorId      String?  @map("actor_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json     @default("{}")
  ipAddress    String?  @map("ip_address")
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Payments (wallet funding through an external provider)
// ---------------------------------------------------------------------------

/// PENDING -> SUCCEEDED | FAILED. A late success may still move FAILED ->
/// SUCCEEDED (the money really arrived). SUCCEEDED is terminal and the wallet
/// is credited exactly once.
enum DepositStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Deposit {
  id             String        @id @default(uuid(7)) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  walletId       String        @map("wallet_id") @db.Uuid
  provider       String
  reference      String
  idempotencyKey String        @map("idempotency_key")
  amount         BigInt
  currency       String        @db.Char(3)
  status         DepositStatus @default(PENDING)
  checkoutUrl    String?       @map("checkout_url")
  transactionId  String?       @unique @map("transaction_id") @db.Uuid
  failureReason  String?       @map("failure_reason")
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id])
  wallet      Wallet       @relation(fields: [walletId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([provider, reference])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("deposits")
}

/// Providers deliver webhooks at least once; the unique key turns a
/// redelivery into a cheap no-op.
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([provider, eventId])
  @@map("webhook_events")
}
